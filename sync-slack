#!/bin/bash

(

# Wait for lock on $0.lock (fd 200) for 10 seconds
/usr/bin/flock -x -w 10 200 || exit 1

RSYNC="/usr/bin/rsync"
# Slackware publishes no formal mirror programme, so these are the same
# conservative flags the other distro trees here use. Daily is the customary
# cadence — the tree changes rarely (releases + occasional -current churn).
OPTS="--quiet --recursive --links --perms --times -D --delete --timeout=300"

# OSU Open Source Lab is one of the long-standing primary Slackware hosts.
SRC1="rsync://slackware.osuosl.org/slackware/"

DST="/srv/ftp/slackware/"

echo "Started update at" `date` >> $0.log 2>&1
/usr/bin/logger -t sync-slack "Re-rsyncing the Slackware tree"
${RSYNC} ${OPTS} ${SRC1} ${DST} >> $0.log 2>&1

echo "End: "`date` >> $0.log 2>&1

) 200>$0.lock
