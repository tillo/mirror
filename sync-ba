#!/bin/bash

(

# Wait for lock on $0.lock (fd 200) for 10 seconds
/usr/bin/flock -x -w 10 200 || exit 1

RSYNC="/usr/bin/rsync"
OPTS="--quiet --recursive --links --perms --times -D --delete --timeout=300"

# Order = measured health, 2026-09-28. blackarch.org itself resets the
# connection mid file-list (read error 104 after ~640 KB) on a full-tree pull,
# and the old SRC2-SRC4 no longer resolve in DNS, so every run fell through to
# team-cymru, which exits 0 while serving a tree 2 days behind (lastupdate
# 2026-09-26 07:34 vs upstream 2026-09-28 04:58). rsync reports success on a
# stale source, so a lagging mirror must never sit ahead of a current one.
# RWTH Aachen and cyberbits.eu both served the current lastupdate over rsync.
SRC1="rsync://ftp.halifax.rwth-aachen.de/blackarch/"
SRC2="rsync://mirror.cyberbits.eu/blackarch/"
SRC3="rsync://blackarch.org/blackarch/"
SRC4="rsync://mirror.team-cymru.org/blackarch/"
SRC5="rsync://mirror.jmu.edu/blackarch/"
SRC6="rsync://mirror.oss.maxcdn.com/mirrors/blackarch/"

DST="/srv/ftp/blackarch/"

echo "Started update at" `date` >> $0.log 2>&1
/usr/bin/logger -t sync-ba "Re-rsyncing the blackarch tree"
${RSYNC} ${OPTS} ${SRC1} ${DST} >> $0.log 2>&1 || \
${RSYNC} ${OPTS} ${SRC2} ${DST} >> $0.log 2>&1 || \
${RSYNC} ${OPTS} ${SRC3} ${DST} >> $0.log 2>&1 || \
${RSYNC} ${OPTS} ${SRC4} ${DST} >> $0.log 2>&1 || \
${RSYNC} ${OPTS} ${SRC5} ${DST} >> $0.log 2>&1 || \
${RSYNC} ${OPTS} ${SRC6} ${DST} >> $0.log 2>&1

echo "End: "`date` >> $0.log 2>&1

) 200>$0.lock
